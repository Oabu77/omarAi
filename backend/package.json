{
  "name": "omar-ai-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply omar-ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply omar-ai --remote"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
