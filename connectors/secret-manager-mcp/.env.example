# Local development only. Generate at least 32 random bytes.
MCP_BEARER_TOKEN=replace-with-a-long-random-development-token

# Vercel API credential. Store as a sensitive runtime variable, never in Git.
VERCEL_TOKEN=replace-at-deployment
VERCEL_TEAM_ID=team_replace_at_deployment

# Exact project IDs or names; wildcards are rejected.
ALLOWED_VERCEL_PROJECTS=prj_replace_at_deployment

# Browser origins only. Server-to-server requests normally omit Origin.
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Optional hardening.
MCP_RATE_LIMIT_PER_MINUTE=30
UPSTREAM_TIMEOUT_MS=8000
MAX_REQUEST_BYTES=262144
MAX_UPSTREAM_BYTES=1048576
HOST=127.0.0.1
PORT=8787
